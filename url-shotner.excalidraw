      "index": "b1H",
      "roundness": null,
      "seed": 1584158146,
      "version": 130,
      "versionNonce": 1017876674,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785333640729,
      "link": null,
      "locked": false,
      "text": "Another thing we can do to reduce latency is to utilize Content Delivery Networks (CDNs)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Another thing we can do to reduce latency is to utilize Content Delivery Networks (CDNs)",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Bg9pjmZHHKfuiyDFjIYux",
      "type": "text",
      "x": 205.02110857399236,
      "y": 3302.3087319333517,
      "width": 724.839599609375,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1I",
      "roundness": null,
      "seed": 23262494,
      "version": 218,
      "versionNonce": 1887814466,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1785333642556,
      "link": null,
      "locked": false,
      "text": "The CDN nodes cache the mappings of short codes to long URLs, allowing\nredirect requests to be handled close to the user's location.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The CDN nodes cache the mappings of short codes to long URLs, allowing redirect requests to be handled close to the user's location.",
      "autoResize": false,
      "lineHeight": 1.25
    },
