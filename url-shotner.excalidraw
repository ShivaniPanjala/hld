      "link": null,
      "locked": false,
      "text": "Functional Requirements\n- users should be able to submit longUrl and recieve shorturl\n    - optional customAlias\n    - optional expirationTime\n- users should be able to access the original URL by using the shortened URL",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Functional Requirements\n- users should be able to submit longUrl and recieve shorturl\n    - optional customAlias\n    - optional expirationTime\n- users should be able to access the original URL by using the shortened URL",
      "autoResize": true,
      "lineHeight": 1.25
    },
