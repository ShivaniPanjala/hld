      "isDeleted": false,
      "boundElements": null,
      "updated": 1785333628590,
      "link": null,
      "locked": false,
      "text": "we can introduce an in-memory cache like Redis or Memcached between the\napplication server and the database",
      "fontSize": 20.24312452920184,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "we can introduce an in-memory cache like Redis or Memcached between the application server and the database",
      "autoResize": false,
