    {
      "id": "i62bwggruNSoMsIjnmnaI",
      "type": "text",
      "x": 110.54554844210168,
      "y": 3500.3446712088953,
      "width": 862.8123687438357,
      "height": 37.01954655906209,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
